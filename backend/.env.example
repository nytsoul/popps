# ShopScale Backend Environment Configuration
# Copy to .env and fill in your values. Never commit .env to source control.

# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
APP_SECRET_KEY=CHANGE_ME_to_a_64_char_random_hex_string
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://shopscale:shopscale@localhost:5432/shopscale
# For async operations:
ASYNC_DATABASE_URL=postgresql+asyncpg://shopscale:shopscale@localhost:5432/shopscale

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Admin Bootstrap ──────────────────────────────────────────────────────────
# Used ONLY for the first-time dev admin creation command. Remove after setup.
BOOTSTRAP_ADMIN_EMAIL=admin@shopscale.dev
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ADAPTER=local             # local | s3 | cloudinary
LOCAL_UPLOAD_DIR=./uploads
# AWS S3 (leave blank when using local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
# Cloudinary (leave blank when using local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_ADAPTER=console             # console | smtp | sendgrid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@shopscale.dev
SENDGRID_API_KEY=

# ── Payment ──────────────────────────────────────────────────────────────────
PAYMENT_ADAPTER=mock              # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
